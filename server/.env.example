# Mẫu cấu hình server — sao chép thành .env rồi điền giá trị thật.
# KHÔNG commit file .env.

# ── Server ───────────────────────────────────────────────
PORT=3000
# Chỉ nghe trên máy local (Apache reverse-proxy /api tới Node)
HOST=127.0.0.1
# production: ẩn chi tiết lỗi. Chỉ đặt "development" trên máy lập trình.
NODE_ENV=production

# ── Database (SQL Server) ────────────────────────────────
DB_HOST=localhost
DB_PORT=1433
DB_NAME=
DB_USER=
DB_PASSWORD=
# Mã hoá kết nối DB — nên bật (true) khi DB nằm ở máy khác trong mạng
DB_ENCRYPT=false
# false khi SQL Server có chứng chỉ hợp lệ (kiểm tra chứng chỉ)
DB_TRUST_CERT=true

# ── Xác thực ─────────────────────────────────────────────
# Chuỗi ngẫu nhiên >= 32 ký tự. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Access token (gọi API) — ngắn hạn, tự làm mới bằng refresh token
ACCESS_TOKEN_TTL=15m
# Refresh token: phiên web không tick "Ghi nhớ đăng nhập" hết hạn sau thời gian
# không hoạt động này; phiên "Ghi nhớ" và client API (Bearer) dùng TTL_REMEMBER
REFRESH_TOKEN_TTL=12h
REFRESH_TOKEN_TTL_REMEMBER=7d
# Tuổi thọ tối đa 1 phiên dù làm mới liên tục (buộc đăng nhập lại định kỳ)
SESSION_MAX_AGE=30d
# Xoá dòng phiên đã hết hạn/thu hồi khỏi DB sau số ngày này
SESSION_RETENTION_DAYS=30
# true khi site chạy HTTPS → cookie phiên chỉ được gửi qua HTTPS
COOKIE_SECURE=false

# ── CORS ─────────────────────────────────────────────────
# Để trống = không cho phép origin khác gọi API (khuyến nghị)
CORS_ORIGIN=

# ── Nhật ký hệ thống (pino + pino-roll) ──────────────────
# Thư mục lưu log (mặc định: server/logs), mỗi ngày 1 file audit.YYYY-MM-DD.N.log
# AUDIT_LOG_DIR=
# Số ngày giữ log — file cũ hơn tự xoá
LOG_RETENTION_DAYS=90
# Tách file khi vượt dung lượng này
# LOG_FILE_SIZE=50m
# Chỉ ghi các method này (để trống = ghi mọi request), vd: POST,PUT,DELETE
# LOG_REQUEST_METHODS=
# 1 = ghi ra stdout thay vì file (khi đã có Loki/Promtail thu log container)
# LOG_STDOUT=
