# Mẫu cấu hình server — sao chép thành .env rồi điền giá trị thật.
# KHÔNG commit file .env.

# ── Server ───────────────────────────────────────────────
PORT=3000
# Chỉ nghe trên máy local (Apache reverse-proxy /api tới Node)
HOST=127.0.0.1
# production: ẩn chi tiết lỗi. Chỉ đặt "development" trên máy lập trình.
NODE_ENV=production

# ── Database (PostgreSQL) ────────────────────────────────
# Tạo DB/role + schema: xem server/db/README.md
DB_HOST=localhost
DB_PORT=5432
DB_NAME=hrm_hospital
# Role ứng dụng (chỉ đọc/ghi dữ liệu) — KHÔNG dùng postgres/hrm_owner
DB_USER=hrm_app
DB_PASSWORD=
# Mã hoá kết nối DB (TLS) — nên bật (true) khi DB nằm ở máy khác trong mạng
DB_SSL=false
# Đặt false CHỈ khi PostgreSQL dùng chứng chỉ tự ký (không kiểm tra chứng chỉ)
DB_SSL_REJECT_UNAUTHORIZED=true
# Thời gian tối đa 1 câu truy vấn (ms), mặc định 15000
# DB_STATEMENT_TIMEOUT_MS=15000

# ── Xác thực ─────────────────────────────────────────────
# BẮT BUỘC — server không khởi động nếu thiếu hoặc < 32 ký tự.
# (DB_HOST, DB_NAME, DB_USER, DB_PASSWORD cũng bắt buộc.)
# Đổi JWT_SECRET = mọi phiên đăng nhập hiện có mất hiệu lực. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Khoá mã hoá secret 2FA (TOTP) lưu trong DB — >= 32 ký tự, giữ cố định.
# Để trống thì suy ra từ JWT_SECRET (khi đó đổi JWT_SECRET = mọi 2FA đang bật
# phải được quản trị tắt rồi thiết lập lại). Tạo bằng lệnh như JWT_SECRET.
TOTP_ENCRYPTION_KEY=
# Thời hạn phiên đăng nhập (JWT trong cookie HttpOnly)
JWT_EXPIRES=8h
# Phiên bỏ không (không thao tác) quá N phút thì phải đăng nhập lại. 0 = tắt
SESSION_IDLE_MINUTES=60
# Mật khẩu do quản trị đặt (tạo TK / đặt lại) phải đổi trong N giờ, quá hạn
# thì không đăng nhập được nữa (nhờ quản trị cấp lại). 0 = không giới hạn
TEMP_PASSWORD_TTL_HOURS=72
# true khi site chạy HTTPS → cookie phiên chỉ được gửi qua HTTPS. File này để
# false cho máy dev (http://localhost); production (NODE_ENV=production) với
# COOKIE_SECURE khác true sẽ bị cảnh báo lúc khởi động.
COOKIE_SECURE=false

# Số hop reverse-proxy đứng trước Node (mặc định 1 = Apache). Đặt 0 nếu Node
# nhận traffic trực tiếp. Sai giá trị → IP dùng cho rate-limit/khoá tài khoản
# bị sai hoặc bị giả mạo qua X-Forwarded-For.
# TRUST_PROXY=1

# ── CORS ─────────────────────────────────────────────────
# Để trống = không cho phép origin khác gọi API (khuyến nghị)
CORS_ORIGIN=

# ── Nhật ký hệ thống (pino + pino-roll) ──────────────────
# Thư mục lưu log (mặc định: server/logs), mỗi ngày 1 file audit.YYYY-MM-DD.N.log
# AUDIT_LOG_DIR=
# Số ngày giữ log — file cũ hơn tự xoá
LOG_RETENTION_DAYS=90
# Tách file khi vượt dung lượng này
# LOG_FILE_SIZE=50m
# Chỉ ghi các method này (để trống = ghi mọi request), vd: POST,PUT,DELETE
# LOG_REQUEST_METHODS=
# 1 = ghi ra stdout thay vì file (khi đã có Loki/Promtail thu log container)
# LOG_STDOUT=
