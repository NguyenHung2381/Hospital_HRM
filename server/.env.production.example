# Cấu hình PRODUCTION khi chạy bằng Docker (docker compose -f docker-compose.prod.yml up -d --build).
# Sao chép thành server/.env.production rồi điền giá trị thật.
# KHÔNG commit .env.production (đã nằm trong .gitignore) — file này cũng không
# bị đóng vào image (.dockerignore); docker compose đọc nó lúc chạy container.
#
# NODE_ENV, HOST, PORT đã cố định trong docker-compose.prod.yml, không cần đặt ở đây.

# ── Database (PostgreSQL cài trực tiếp trên máy chủ) ─────
# PostgreSQL trên chính máy chạy Docker → host.docker.internal (PostgreSQL phải
# nghe trên interface mạng Docker + pg_hba.conf cho phép — xem server/db/README.md).
# DB ở máy khác → đặt IP/tên máy đó (vd 192.168.1.10).
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=hrm_hospital
# Role ứng dụng hrm_app (tạo bằng server/db/postgres/000_roles_database.sql):
# chỉ đọc/ghi dữ liệu, không có quyền tạo/sửa bảng. KHÔNG dùng "postgres".
# Schema do hrm_owner tạo trước bằng 001_init.sql, 002_views_functions.sql.
DB_USER=hrm_app
DB_PASSWORD=
# Mã hoá kết nối app <-> PostgreSQL (cần bật ssl = on trong postgresql.conf).
# Chứng chỉ tự ký → DB_SSL_REJECT_UNAUTHORIZED=false. Cùng máy, chưa bật SSL → DB_SSL=false.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

# ── Xác thực ─────────────────────────────────────────────
# BẮT BUỘC, >= 32 ký tự, KHÁC với secret ở máy dev. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Đổi giá trị này = mọi phiên đăng nhập hiện có mất hiệu lực.
JWT_SECRET=
JWT_EXPIRES=8h
# Site chạy HTTPS → cookie phiên chỉ gửi qua HTTPS (cờ Secure).
# Đặt false CHỈ khi thử production-style bằng http:// (nếu không sẽ không đăng nhập được).
COOKIE_SECURE=true

# ── Proxy ────────────────────────────────────────────────
# TRUST_PROXY đã ghim = 1 trong docker-compose.prod.yml (nginx container). IP proxy
# HTTPS đứng trước khai bằng TRUSTED_PROXIES trong file .env cạnh compose.

# ── CORS ─────────────────────────────────────────────────
# Để trống: trình duyệt gọi /api cùng origin (https://dieuduong.bvnghean.vn)
# qua nginx, không cần CORS.
CORS_ORIGIN=

# ── Nhật ký hệ thống ─────────────────────────────────────
# Số ngày giữ log (volume api-logs) — file cũ hơn tự xoá
LOG_RETENTION_DAYS=90
