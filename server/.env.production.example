# Cấu hình PRODUCTION khi chạy bằng Docker (docker compose up -d --build).
# Sao chép thành server/.env.production rồi điền giá trị thật.
# KHÔNG commit .env.production (đã nằm trong .gitignore) — file này cũng không
# bị đóng vào image (.dockerignore); docker compose đọc nó lúc chạy container.
#
# NODE_ENV, HOST, PORT đã cố định trong docker-compose.yml, không cần đặt ở đây.

# ── Database (SQL Server) ────────────────────────────────
# SQL Server trên chính máy chạy Docker → host.docker.internal.
# DB ở máy khác → đặt IP/tên máy đó (vd 192.168.1.10 hoặc 192.168.1.10\SQLEXPRESS).
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=HRM_Hospital
# KHÔNG dùng "sa" — tạo 1 SQL login riêng chỉ có quyền trên DB HRM.
# Lần chạy đầu server tự tạo bảng/cột bảo mật → login này cần quyền
# ALTER/CREATE TABLE (hoặc chạy trước: node src/config/securitySchema.js bằng tài khoản có quyền).
DB_USER=
DB_PASSWORD=
# Mã hoá kết nối app <-> SQL Server. SQL Server chưa cài chứng chỉ vẫn tự
# sinh cert tự ký → giữ DB_TRUST_CERT=true. Có cert CA thật → đặt false.
DB_ENCRYPT=true
DB_TRUST_CERT=true

# ── Xác thực ─────────────────────────────────────────────
# BẮT BUỘC, >= 32 ký tự, KHÁC với secret ở máy dev. Tạo bằng:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Đổi giá trị này = mọi phiên đăng nhập hiện có mất hiệu lực.
JWT_SECRET=
JWT_EXPIRES=8h
# Site chạy HTTPS → cookie phiên chỉ gửi qua HTTPS (cờ Secure).
# Đặt false CHỈ khi thử production-style bằng http:// (nếu không sẽ không đăng nhập được).
COOKIE_SECURE=true

# ── Proxy ────────────────────────────────────────────────
# Số hop reverse-proxy đứng trước Node. Trong Docker: nginx (container web) = 1.
TRUST_PROXY=1

# ── CORS ─────────────────────────────────────────────────
# Để trống: trình duyệt gọi /api cùng origin qua nginx, không cần CORS.
CORS_ORIGIN=

# ── Nhật ký hệ thống ─────────────────────────────────────
# Số ngày giữ log (volume api-logs) — file cũ hơn tự xoá
LOG_RETENTION_DAYS=90
